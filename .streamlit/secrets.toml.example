# Copie este archivo como .streamlit/secrets.toml (NO lo suba a GitHub)
# En Streamlit Community Cloud se pega en Settings > Secrets.

# Cadena de conexión de Supabase (Project Settings > Database > Connection string > URI).
DATABASE_URL = "postgresql+psycopg2://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Opcional: correo para los recordatorios de mantenimiento (RF-08)
[smtp]
servidor = "smtp.gmail.com"
puerto = 587
usuario = "fueltrack.app@gmail.com"
clave = "clave-de-aplicacion"
